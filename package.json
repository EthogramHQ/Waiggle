{
  "name": "ruche",
  "private": true,
  "description": "Réseau social pour publier, suivre et tester les projets IA de ses proches.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm arch --check && pnpm typecheck && pnpm test",
    "arch": "node scripts/architecture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "esbuild": "0.28.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
