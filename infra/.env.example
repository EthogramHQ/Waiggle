# Modèle du fichier des secrets. Ne jamais le committer une fois rempli.
# - Sur le serveur : /srv/ruche/secrets.env, lisible par son seul propriétaire (docs/ops/serveur.md).
# - Sur son ordinateur : infra/.env, pour essayer avec Docker (voir infra/docker-compose.yml).
# Les adresses publiques (domaines) ne sont pas ici mais dans infra/site.env.

# Base de données : mot de passe long et aléatoire, sans caractères spéciaux (openssl rand -hex 32)
POSTGRES_DB=ruche
POSTGRES_USER=ruche
POSTGRES_PASSWORD=

# Clé secrète des sessions, 32 caractères minimum : openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mails : "console" (affichés dans les logs), "scaleway" (envoi réel, sans traqueur : ADR 0005)
# ou "brevo" (envoi réel, avec les traqueurs de Brevo).
MAIL_PROVIDER=console
# Scaleway Transactional Email : la clé secrète d'une application IAM limitée à ce service, et
# l'identifiant (UUID) du projet où le domaine d'envoi est vérifié. Région : fr-par (Paris).
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com
# Nom de l'expéditeur. Vide : le nom de l'appli (packages/brand/src/name.ts)
MAIL_FROM_NAME=
# "true" autorise MAIL_PROVIDER=console avec NODE_ENV=production. Seulement pour essayer sur son
# ordinateur : les liens des e-mails (qui connectent au compte) finiraient dans les logs.
ALLOW_CONSOLE_MAIL=
# Les e-mails de notification (le récap de la semaine, les e-mails de mentions) : "on" (ou vide)
# pour les envoyer, "off" pour les couper ; la purge de nuit continue dans les deux cas. Toute autre
# valeur empêche l'API de démarrer. À mettre à "off" AVANT de restaurer une sauvegarde : elle
# ramènerait des comptes supprimés et des désinscriptions annulées depuis (docs/ops/serveur.md,
# « Sauvegardes »). Les tâches ne tournent qu'avec un vrai PostgreSQL (jamais avec PGlite).
EMAIL_JOBS=

# Code d'invitation demandé à l'inscription : au moins 12 caractères, majuscules et espaces autour
# ignorés. Le tirer au hasard (openssl rand -hex 8), jamais un mot ou une date faciles à deviner.
# Le plus simple pour ses proches : leur envoyer le lien https://<domaine>/sign-up?code=<code>.
SIGNUP_INVITE_CODE=
