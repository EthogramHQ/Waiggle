{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.expo", "!**/expo-env.d.ts", "!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "markdown": {
    "formatter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/app/src/screens/**",
        "apps/app/src/navigation/**",
        "apps/app/app/**",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": [
                      "Text",
                      "TextInput",
                      "View",
                      "ScrollView",
                      "Pressable",
                      "TouchableOpacity",
                      "Image",
                      "StyleSheet"
                    ],
                    "message": "Un écran assemble les composants de src/ui (Text, Stack, Surface, Button, TextField…) au lieu de dessiner lui-même : ainsi, changer l'apparence se fait à un seul endroit. Il manque un composant ? Ajoute-le dans src/ui et au catalogue (voir docs/design/miel.md)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
