{
  "name": "@ruche/app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mts",
    "shots": "node scripts/shots.mjs",
    "journey": "node scripts/journey-local.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.13",
    "@better-auth/utils": "0.5.1",
    "@expo-google-fonts/funnel-display": "0.4.1",
    "@expo-google-fonts/funnel-sans": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@ruche/brand": "workspace:*",
    "@ruche/contracts": "workspace:*",
    "@ruche/i18n": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.13",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "26.5.10",
    "marked": "18.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.1.9",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|marked))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
